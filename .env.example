# Credentials from the SAME X developer app. Never commit a populated .env.
# Complete live setup: app bearer, OAuth 2.0 access/refresh pair and Client ID.
# The installer requires these for live use; library callers may manage token expiry themselves.
# Leave all X settings blank to explore the offline demo without X API calls.
X_APP_BEARER_TOKEN=
# Optional with X_USER_ACCESS_TOKEN: one startup lookup identifies that account.
# An explicit ID selects that account and skips the startup lookup.
X_USER_ID=

# Required by the installer for live use and for private features.
# Automatic self-identification also needs this token (users.read and tweet.read).
# Supply an OAuth 2.0 user-context access token for X_USER_ID with follows.read.
# Follow/Unfollow also needs tweet.read, users.read and follows.write.
# Interactions need users.read, tweet.read; likes also need like.read.
# Obtain the access/refresh pair outside XFlog. Renewal settings are below.
X_USER_ACCESS_TOKEN=

# Required by the installer for live use. Authorize with offline.access to obtain a refresh token.
# Library callers can omit renewal settings if they supply fresh user tokens themselves.
# Rotated tokens are saved privately in the history database; .env is not rewritten.
X_USER_REFRESH_TOKEN=
X_CLIENT_ID=
# Only for confidential OAuth clients (Web App/Automated App/Bot); blank for Native Apps.
X_CLIENT_SECRET=

# Optional for localhost: leave empty to disable browser password protection.
# Required for remote access: use 16+ ASCII characters. Browser username: xflog.
# This protects XFlog; it is NOT your X password.
XFLOG_ADMIN_PASSWORD=

# Browser-facing origin, without a trailing slash or path. Use HTTPS on a VPS.
XFLOG_ORIGIN=http://127.0.0.1:7860
# Optional host .env path shown in Profile setup help. The installer fills this in.
# Manual deployments: set it to the file your launcher loads. This does not load a file.
XFLOG_ENV_FILE=
# Optional Compose host port. Also update XFLOG_ORIGIN when changing it.
XFLOG_PUBLISH_PORT=7860

# Compose persists /data as a named volume. Native installs have a separate default.
# XFLOG_DATABASE=/data/history.sqlite3
# Native server bind settings; Docker binds internally to 0.0.0.0:7860.
# XFLOG_HOST=127.0.0.1
# XFLOG_PORT=7860
# Compose declares its host-loopback port binding automatically.
# Other container launchers may set XFLOG_LOOPBACK_PUBLISHED=1 ONLY with loopback-only publication.
GRADIO_ANALYTICS_ENABLED=False
